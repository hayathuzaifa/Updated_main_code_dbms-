   f.EMP_ID,
    f.FACULTY_NAME,
    f.SALARY
FROM faculty188 f
JOIN department188 d
    ON d.HEAD_ID=f.EMP_ID
WHERE d.DEPARTMENT_ID IN (
    SELECT c.OFFERING_DEPT
    FROM course188 c
    JOIN contains188 co
        ON c.CID = co.COURSE_ID
    JOIN subjectpaper188 s
        ON co.PAPER_ID = s.PAPER_CODE
    WHERE LOWER(s.PAPER_NAME) LIKE '%machine%'
);

--f. 
SELECT
    st.ROLL,
    st.SNAME,
    st.ENROLLED_COURSE,
    SUM(e.MARKS) AS aggregate_marks
FROM student188 st
JOIN course188 c
    ON st.ENROLLED_COURSE = c.CID
JOIN contains188 co
    ON c.CID = co.COURSE_ID
JOIN exam188 e
    ON st.ROLL = e.PERFORMED_BY_STUDENT
   AND co.PAPER_ID = e.PAPER_CODE
WHERE UPPER(c.CNAME) = 'BTECH'
  AND UPPER(c.DISCIPLINE) = 'CSE'
  AND co.SEMESTER = 5
  AND e.SESSIONS = EXTRACT(YEAR FROM SYSDATE)
GROUP BY st.ROLL, st.SNAME, st.ENROLLED_COURSE;

--g. 
WITH student_total AS (
    SELECT
        c.CID,
        c.CNAME,
        c.DISCIPLINE,
        co.SEMESTER,
        e.SESSIONS,
        st.ROLL,
        st.SNAME,
        SUM(e.MARKS) AS aggregate_MARKS
    FROM course188 c
    JOIN contains188 co
        ON c.CID = co.COURSE_ID
    JOIN exam188 e
        ON co.PAPER_ID = e.PAPER_CODE
    JOIN student188 st
        ON e.PERFORMED_BY_STUDENT = st.ROLL
       AND st.ENROLLED_COURSE = c.CID
    WHERE co.SEMESTER = co.SEMESTER
    GROUP BY
        c.CID, c.CNAME, c.DISCIPLINE,
        co.SEMESTER, e.SESSIONS,
        st.ROLL, st.SNAME
),
ranked_students AS (
    SELECT
        student_total.*,
        RANK() OVER (
            PARTITION BY CID, SEMESTER, SESSIONS
            ORDER BY aggregate_marks DESC
        ) AS student_rank
    FROM student_total
)
