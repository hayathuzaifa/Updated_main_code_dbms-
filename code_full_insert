SELECT 
    d.DEPARTMENT_ID,
    d.DNAME,
    MAX(f.SALARY) AS maximum_SALARY, 
    AVG(f.SALARY) AS average_SALARY,
    MIN(f.SALARY) AS minimum_SALARY
FROM department188 d
JOIN faculty188 f
    ON d.DEPARTMENT_ID = f.UNDER_DEPT
GROUP BY d.DEPARTMENT_ID, d.DNAME
HAVING AVG(f.SALARY) >= 10000;


select 
        d.DEPARTMENT_ID,
        d.DNAME,
         avg(f.SALARY) as average_SALARY
          from department188 d
           join faculty188 f
           on d.DEPARTMENT_ID = f.UNDER_DEPT
     where d.DEPARTMENT_ID in (
        select c.OFFERING_DEPT
        from course188 c
        where upper(c.CNAME) in ('BTECH','MTECH')
    group by c.OFFERING_DEPT
        having count(distinct upper(c.CNAME)) = 2
)
        group by  d.DEPARTMENT_ID ,d.DNAME 
        having count(distinct f.EMP_ID) >= 2;


