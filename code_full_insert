-- ==============================================================
-- 1. SUBJECTPAPER188
-- ==============================================================
CREATE TABLE SUBJECTPAPER188 (
    PAPER_CODE VARCHAR2(20 BYTE),
    PAPER_NAME VARCHAR2(100 BYTE),
    CREDIT     NUMBER(3, 0),
    CONSTRAINT CONS_PKEY_PAPER_CODE PRIMARY KEY (PAPER_CODE)
);

-- ==============================================================
-- 2. DEPARTMENT188
-- (Note: Circular Foreign Key CONS_FKEY_HEAD_OF_DEPT is added after
--  FACULTY188 is created, because FACULTY188 does not exist yet)
-- ==============================================================
CREATE TABLE DEPARTMENT188 (
    DEPARTMENT_ID VARCHAR2(20 BYTE),
    DNAME         VARCHAR2(100 BYTE) CONSTRAINT CONS_NNULL_DNAME NOT NULL,
    HEAD_ID       VARCHAR2(20 BYTE),
    CONSTRAINT CONS_PKEY_DID PRIMARY KEY (DEPARTMENT_ID),
    CONSTRAINT CONS_UNIQUE_DNAME UNIQUE (DNAME)
);

-- ==============================================================
-- 3. FACULTY188
-- ==============================================================
CREATE TABLE FACULTY188 (
    EMP_ID       VARCHAR2(20 BYTE),
    SALARY       NUMBER(5, 0),
    MOBILE       NUMBER(10, 0) CONSTRAINT CONS_NNULL_MOB NOT NULL,
    FACULTY_NAME VARCHAR2(40 BYTE) CONSTRAINT CONS_NNULL_FAC NOT NULL,
    UNDER_DEPT   VARCHAR2(20 BYTE),
    SUPERVISOR   VARCHAR2(20 BYTE),
    JOINING_DATE DATE,
    DOB          DATE,
    CONSTRAINT CONS_PKEY_EMPID PRIMARY KEY (EMP_ID),
    CONSTRAINT CONS_CKEY_FAC_NAME UNIQUE (MOBILE),
    CONSTRAINT CONS_FKEY_IN_DEPT FOREIGN KEY (UNDER_DEPT)
        REFERENCES DEPARTMENT188 (DEPARTMENT_ID),
    CONSTRAINT CONS_FKEY_SUPERVISOR FOREIGN KEY (SUPERVISOR)
        REFERENCES FACULTY188 (EMP_ID)
);

-- Add the circular Foreign Key on DEPARTMENT188 referencing FACULTY188
ALTER TABLE DEPARTMENT188
    ADD CONSTRAINT CONS_FKEY_HEAD_OF_DEPT FOREIGN KEY (HEAD_ID)
        REFERENCES FACULTY188 (EMP_ID);

-- ==============================================================
-- 4. COURSE188
-- ==============================================================
CREATE TABLE COURSE188 (
    CID           VARCHAR2(30 BYTE),
    CNAME         VARCHAR2(100 BYTE) CONSTRAINT CONS_NNULL_CNAME NOT NULL,
    DISCIPLINE    VARCHAR2(100 BYTE),
    OFFERING_DEPT VARCHAR2(20 BYTE),
    CONSTRAINT CONS_PKEY_CID PRIMARY KEY (CID),
    CONSTRAINT CONS_UKEY_CNAME UNIQUE (CNAME),
    CONSTRAINT CONS_UKEY_DICI UNIQUE (DISCIPLINE),
    CONSTRAINT CONS_FKEY_COURSE_DEPT_DID FOREIGN KEY (OFFERING_DEPT)
        REFERENCES DEPARTMENT188 (DEPARTMENT_ID)
);

-- ==============================================================
-- 5. SECTION188
-- ==============================================================
CREATE TABLE SECTION188 (
    SECTION_ID      VARCHAR2(50 BYTE),
    BATCHES         NUMBER(1, 0) CONSTRAINT CONS_NNULL_BACHES_STUD NOT NULL,
    STUDYING_COURSE VARCHAR2(30 BYTE),
    CONSTRAINT CONS_PKEY_ID PRIMARY KEY (SECTION_ID),
    CONSTRAINT CONS_FKEY_SEC_COURSE_CID FOREIGN KEY (STUDYING_COURSE)
        REFERENCES COURSE188 (CID)
);

-- ==============================================================
-- 6. CONTAINS188
-- ==============================================================
CREATE TABLE CONTAINS188 (
    COURSE_ID VARCHAR2(30 BYTE),
    PAPER_ID  VARCHAR2(20 BYTE),
    SEMESTER  NUMBER(1, 0) CONSTRAINT CONS_NNULL_SEM_ESTER NOT NULL,
    CONSTRAINT CONS_PKEY_COURSE PRIMARY KEY (COURSE_ID, PAPER_ID),
    CONSTRAINT CONS_FKEY_CON_COURSE FOREIGN KEY (COURSE_ID)
        REFERENCES COURSE188 (CID),
    CONSTRAINT CONS_FKEY_CON_PAPERS FOREIGN KEY (PAPER_ID)
        REFERENCES SUBJECTPAPER188 (PAPER_CODE)
);

-- ==============================================================
-- 7. TEACHES188
-- ==============================================================
CREATE TABLE TEACHES188 (
    TEACH_BY_FAC VARCHAR2(20 BYTE),
    TEACHING_SUB VARCHAR2(20 BYTE),
    TSESSION     NUMBER(4, 0) CONSTRAINT CONS_NNULL_T_SESSION NOT NULL,
    CONSTRAINT CONS_PKEY_FAC_SUB PRIMARY KEY (TEACH_BY_FAC, TEACHING_SUB),
    CONSTRAINT CONS_FKEY_T_FAC FOREIGN KEY (TEACH_BY_FAC)
        REFERENCES FACULTY188 (EMP_ID),
    CONSTRAINT CONS_FKEY_T_SUB_PAP FOREIGN KEY (TEACHING_SUB)
        REFERENCES SUBJECTPAPER188 (PAPER_CODE)
);

-- ==============================================================
-- 8. INSTRUCTS188
-- ==============================================================
CREATE TABLE INSTRUCTS188 (
    INSTRUCT_FAC VARCHAR2(20 BYTE),
    INSTRUCT_SEC VARCHAR2(20 BYTE),
    ISESSION     NUMBER(4, 0) CONSTRAINT CONS_NNULL_SESSION NOT NULL,
    CONSTRAINT CONS_PKEY_FAC_SECTION PRIMARY KEY (INSTRUCT_FAC, INSTRUCT_SEC),
    CONSTRAINT CONS_INC_FAC FOREIGN KEY (INSTRUCT_FAC)
        REFERENCES FACULTY188 (EMP_ID),
    CONSTRAINT CONS_INC_SEC FOREIGN KEY (INSTRUCT_SEC)
        REFERENCES SECTION188 (SECTION_ID)
);

-- ==============================================================
-- 9. STUDENT188
-- ==============================================================
CREATE TABLE STUDENT188 (
    SNAME            VARCHAR2(80 BYTE),
    DOB              DATE CONSTRAINT CONS_NNULL_DOB_STUDENT NOT NULL,
    ROLL             NUMBER(2, 0),
    EMAIL            VARCHAR2(100 BYTE) CONSTRAINT CONS_NNULL_EMAILS_STUDENT NOT NULL,
    MOB              NUMBER(10, 0) CONSTRAINT CONS_NULL_MOB_NO NOT NULL,
    ADD_PINCODE      NUMBER(7, 0),
    ADD_CITY         VARCHAR2(100 BYTE),
    ADD_HOUSENO      NUMBER(2, 0),
    ENROLLED_COURSE  VARCHAR2(30 BYTE),
    UNDER_SECID      VARCHAR2(50 BYTE),
    ENROLLED_SESSION NUMBER(4, 0),
    CONSTRAINT CONS_PKEY_ROLL PRIMARY KEY (ROLL),
    CONSTRAINT CONS_CKEY_MOB_EMAIL UNIQUE (EMAIL, MOB),
    CONSTRAINT CONS_CKEY_NAME_ADD UNIQUE (SNAME, ADD_HOUSENO, ADD_CITY, ADD_PINCODE),
    CONSTRAINT CONS_FKEY_COURSE_ID FOREIGN KEY (ENROLLED_COURSE)
        REFERENCES COURSE188 (CID),
    CONSTRAINT CONS_FKEY_SEC_ID FOREIGN KEY (UNDER_SECID)
        REFERENCES SECTION188 (SECTION_ID)
);

-- ==============================================================
-- 10. EXAM188
-- ==============================================================
CREATE TABLE EXAM188 (
    PAPER_CODE           VARCHAR2(20 BYTE),
    SESSIONS             VARCHAR2(10 BYTE),
    MARKS                NUMBER(3, 0) CONSTRAINT CONS_NNULL_MARKS NOT NULL,
    PERFORMED_BY_STUDENT NUMBER(2, 0),
    CONSTRAINT CONS_PKEY_CODE_SESSION_ROLL PRIMARY KEY (PAPER_CODE, SESSIONS, PERFORMED_BY_STUDENT),
    CONSTRAINT CONS_FKEY_PCODE FOREIGN KEY (PAPER_CODE)
        REFERENCES SUBJECTPAPER188 (PAPER_CODE),
    CONSTRAINT CONS_FKEY_EXAM_PER_STU FOREIGN KEY (PERFORMED_BY_STUDENT)
        REFERENCES STUDENT188 (ROLL)
);

